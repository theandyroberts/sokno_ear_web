# soknoear.com — reverse proxy to the Next.js standalone server (PM2, port 3007).
# certbot --nginx adds the 443 server block + HTTP->HTTPS redirect.
server {
    listen 80;
    listen [::]:80;
    server_name soknoear.com www.soknoear.com;

    # modest body limit for the event/news submission form
    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:3007;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
