# SQLite database path (on the VPS use /var/lib/soknoear/ear.db)
SQLITE_PATH=./data/ear.db

# Resend email (submission notifications)
RESEND_API_KEY=
SUBMIT_FROM=The Ear <ear@send.note15.com>
SUBMIT_TO=andy@note15.com

# Analytics (NEXT_PUBLIC_* → read at BUILD time; must be in .env.local before `npm run build`).
# Google Analytics (GA4) measurement ID, and Microsoft Clarity heatmaps project ID.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
