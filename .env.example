# SQLite database path (on the VPS use /var/lib/soknoear/ear.db)
SQLITE_PATH=./data/ear.db

# Resend email (submission notifications)
RESEND_API_KEY=
SUBMIT_FROM=The Ear <ear@send.note15.com>
SUBMIT_TO=andy@note15.com

# AgentPhone intake webhook
# AgentPhone returns this secret when creating/updating the webhook. Required in production.
AGENTPHONE_WEBHOOK_SECRET=
# Optional for local webhook tests. Production requires signatures unless this is explicitly false.
AGENTPHONE_WEBHOOK_REQUIRE_SIGNATURE=

# OpenAI structured extraction for AgentPhone call transcripts
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-5.4-nano

# Analytics (NEXT_PUBLIC_* → read at BUILD time; must be in .env.local before `npm run build`).
# Google Analytics (GA4) measurement ID, and Microsoft Clarity heatmaps project ID.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
