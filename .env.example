# SQLite database path (on the VPS use /var/lib/soknoear/ear.db)
SQLITE_PATH=./data/ear.db

# Resend email (submission notifications)
RESEND_API_KEY=
SUBMIT_FROM=The Ear <ear@send.note15.com>
SUBMIT_TO=andy@note15.com

# Google Analytics (GA4). Set the measurement ID to turn on tracking, then rebuild.
# Read at BUILD time (NEXT_PUBLIC_*), so it must be in .env.local before `npm run build`.
NEXT_PUBLIC_GA_ID=
